{
  "name": "IndianAirlinesTheme",
  "dataColors": [
    "#D7263D",
    "#F26522",
    "#E3A12F",
    "#F4C29B",
    "#B9583A",
    "#7A2E8C",
    "#1F3C88",
    "#2B9348"
  ],
  "foreground": "#1A1E28",
  "background": "#FFFFFF",
  "tableAccent": "#F26522",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "color": "#677083",
      "fontSize": 10
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#1A1E28",
      "fontSize": 14
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false,
            "radius": 14
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Bottom",
            "color": {
              "solid": {
                "color": "#1A1E28"
              }
            },
            "transparency": 88
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#ECEEF2"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#ECEEF2"
              }
            }
          }
        ]
      }
    }
  }
}