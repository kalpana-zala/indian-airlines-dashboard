model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","Fact_Flights","Dim_Airline"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Fact_Flights
ref table Dim_Airline
ref table Dim_Date
ref table 'Airline Selector'


