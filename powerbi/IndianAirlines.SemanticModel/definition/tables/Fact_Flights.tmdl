table Fact_Flights
	lineageTag: 53d789ce-9aa1-4e93-ae31-4f15e0493472

	measure 'Total Passengers' = SUM(Fact_Flights[Passengers])
		formatString: #,0
		lineageTag: 2018a083-9917-41f7-884d-2053e4e753fd

	measure 'Passenger Capacity' = SUM(Fact_Flights[Capacity])
		formatString: #,0
		lineageTag: b22d11d2-9e01-4d09-9f1e-ee21e5455dc9

	measure 'Avg Fuel Efficiency' = AVERAGE(Fact_Flights[FuelEfficiency])
		formatString: 0.00
		lineageTag: 83dea35d-6f55-4d1d-a52b-d3d2fe50c234

	measure 'Avg CO2 Per Pax' = AVERAGE(Fact_Flights[CO2PerPax])
		formatString: 0.00
		lineageTag: 51806b4e-5df1-4616-ae8a-87f01b3e19b2

	measure 'Avg Flight Duration' = AVERAGE(Fact_Flights[FlightDuration])
		formatString: 0.00
		lineageTag: acd7bfe5-fadd-4f8e-818f-9cdadd9f9457

	measure 'Total Profit' = SUM(Fact_Flights[Profit])
		formatString: #,0
		lineageTag: 73d14176-baf9-441a-a6e6-1de2b7b512e8

	measure 'Avg Rating' = AVERAGE(Dim_Airline[Rating])
		formatString: 0.00
		lineageTag: be9912d1-9800-4baa-8d4d-634a1c6b57f6

	measure 'Selected Airline' = SELECTEDVALUE('Airline Selector'[Airline], "All Airlines")
		lineageTag: 2336a8b8-4f9f-41ba-9713-d116ef7dfc16

	measure 'Sel Passengers' = CALCULATE([Total Passengers], TREATAS(VALUES('Airline Selector'[Airline]), Dim_Airline[Airline]))
		formatString: #,0
		lineageTag: 2e54c0ad-f435-486d-843b-d89f83962b8d

	measure 'Sel Capacity' = CALCULATE([Passenger Capacity], TREATAS(VALUES('Airline Selector'[Airline]), Dim_Airline[Airline]))
		formatString: #,0
		lineageTag: f119ae13-b82f-452b-a4ba-36114e46a8c0

	measure 'Sel Fuel Efficiency' = CALCULATE([Avg Fuel Efficiency], TREATAS(VALUES('Airline Selector'[Airline]), Dim_Airline[Airline]))
		formatString: 0.00
		lineageTag: e19147ea-f9e6-4a46-9ec2-a252f1fb9768

	measure 'Sel CO2 Per Pax' = CALCULATE([Avg CO2 Per Pax], TREATAS(VALUES('Airline Selector'[Airline]), Dim_Airline[Airline]))
		formatString: 0.00
		lineageTag: 064a7796-0065-43a2-b576-d274c6eb6c3d

	measure 'Sel Flight Duration' = CALCULATE([Avg Flight Duration], TREATAS(VALUES('Airline Selector'[Airline]), Dim_Airline[Airline]))
		formatString: 0.00
		lineageTag: 40b68362-2db1-4dcc-9a38-024509898812

	measure 'Selected Plane URL' = LOOKUPVALUE(Dim_Airline[PlaneImage], Dim_Airline[Airline], SELECTEDVALUE('Airline Selector'[Airline], "Air India"))
		dataCategory: ImageUrl
		lineageTag: 43c51b94-01eb-480e-b295-ed4af65b77b1

	measure 'Bar Color' = IF(SELECTEDVALUE(Dim_Airline[Airline]) = SELECTEDVALUE('Airline Selector'[Airline]), "#F26522", "#F4C29B")
		lineageTag: 3256941b-6661-41b9-9721-f0ed036fa497

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: c1242b2c-fa1c-446c-a621-cd06ae825b58
		summarizeBy: none
		sourceColumn: Date

	column Airline
		dataType: string
		lineageTag: a11d8f47-19d0-48f0-9c30-5dab082251fd
		summarizeBy: none
		sourceColumn: Airline

	column Route
		dataType: string
		lineageTag: 969db280-c3d4-4bde-9ed9-1d0235f647b5
		summarizeBy: none
		sourceColumn: Route

	column SourceCity
		dataType: string
		lineageTag: c16fc219-55fa-443c-98f7-ef3b69624764
		summarizeBy: none
		sourceColumn: SourceCity

	column DestinationCity
		dataType: string
		lineageTag: 035d7528-25f9-4877-8a08-a1b244c20663
		summarizeBy: none
		sourceColumn: DestinationCity

	column Passengers
		dataType: int64
		formatString: 0
		lineageTag: 06940197-286b-4b0b-8439-1dab297a86dd
		summarizeBy: sum
		sourceColumn: Passengers

		annotation SummarizationSetBy = Automatic

	column Capacity
		dataType: int64
		formatString: 0
		lineageTag: add996a7-1b31-4d50-9f18-2a45309222cd
		summarizeBy: sum
		sourceColumn: Capacity

		annotation SummarizationSetBy = Automatic

	column FuelEfficiency
		dataType: double
		formatString: 0.00
		lineageTag: eca3c730-3480-425b-ae0f-2ca5e6ea1480
		summarizeBy: sum
		sourceColumn: FuelEfficiency

		annotation SummarizationSetBy = Automatic

	column CO2PerPax
		dataType: double
		formatString: 0.00
		lineageTag: a0c5d8ac-54fa-459e-b288-e93bd02fd463
		summarizeBy: sum
		sourceColumn: CO2PerPax

		annotation SummarizationSetBy = Automatic

	column FlightDuration
		dataType: double
		formatString: 0.00
		lineageTag: 23673ca1-70e7-498f-9ad2-0c72c4d5d7b1
		summarizeBy: sum
		sourceColumn: FlightDuration

		annotation SummarizationSetBy = Automatic

	column Profit
		dataType: double
		formatString: #,0
		lineageTag: c3db8a80-2159-483a-bfff-1f29d93c4664
		summarizeBy: sum
		sourceColumn: Profit

		annotation SummarizationSetBy = Automatic

	partition Fact_Flights = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_Flights.csv"),[Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"Date", type date}, {"Airline", type text}, {"Route", type text}, {"SourceCity", type text}, {"DestinationCity", type text}, {"Passengers", Int64.Type}, {"Capacity", Int64.Type}, {"FuelEfficiency", type number}, {"CO2PerPax", type number}, {"FlightDuration", type number}, {"Profit", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

